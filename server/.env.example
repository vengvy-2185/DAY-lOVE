# Postgres (Supabase connection string — use the "Transaction" pooler URI for DATABASE_URL
# and the direct connection for DIRECT_URL if you add one to schema.prisma)
DATABASE_URL="postgresql://postgres:PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres"

# App
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# JWT
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Login codes
LOGIN_CODE_TTL_MINUTES=5

# Supabase Storage (for media uploads)
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_BUCKET="day-life-media"

# Auto-delete job
AUTO_DELETE_CRON="*/15 * * * *"
